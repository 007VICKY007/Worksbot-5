{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-debug-assistant/schemas/debug_report.schema.json",
  "title": "DebugReport",
  "description": "The top-level output of a full pipeline run, combining diagnosis, fix, and test results for a developer to review.",
  "type": "object",
  "required": ["report_id", "job_id", "status", "input_summary", "diagnosis", "fixes", "created_at"],
  "properties": {
    "report_id": {
      "type": "string",
      "description": "Unique identifier for this report (UUID)."
    },
    "job_id": {
      "type": "string",
      "description": "ID of the debugging job/run that produced this report."
    },
    "status": {
      "type": "string",
      "enum": ["completed_verified_fix", "completed_unverified_fix", "completed_no_fix_found", "failed", "in_progress"],
      "description": "Overall outcome of the debugging run."
    },
    "input_summary": {
      "type": "object",
      "description": "Summary of what was submitted for this run.",
      "required": ["repo_ref"],
      "properties": {
        "repo_ref": { "type": "string", "description": "Repository path or URL analyzed." },
        "commit_sha": { "type": "string" },
        "log_entry_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stack_trace_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "code_context": {
      "type": "array",
      "description": "CodeContext chunks retrieved and used during diagnosis.",
      "items": { "type": "string", "description": "chunk_id reference into CodeContext records" }
    },
    "diagnosis": {
      "$ref": "diagnosis.schema.json"
    },
    "fixes": {
      "type": "array",
      "description": "All candidate fixes generated, ordered by rank.",
      "items": { "$ref": "fix_suggestion.schema.json" },
      "minItems": 0
    },
    "test_results": {
      "type": "array",
      "description": "TestResult records, one per fix candidate that was validated.",
      "items": { "$ref": "test_result.schema.json" }
    },
    "recommended_fix_id": {
      "type": "string",
      "description": "fix_id of the best verified fix, if any."
    },
    "human_review_required": {
      "type": "boolean",
      "description": "True if no fix passed automated validation, or confidence is below the approval threshold."
    },
    "markdown_report": {
      "type": "string",
      "description": "Rendered human-readable Markdown version of this report."
    },
    "metrics": {
      "type": "object",
      "description": "Operational metrics for the run.",
      "properties": {
        "total_duration_ms": { "type": "integer" },
        "llm_calls": { "type": "integer" },
        "llm_tokens_used": { "type": "integer" },
        "estimated_cost_usd": { "type": "number" }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
