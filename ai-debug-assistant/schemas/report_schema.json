{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DebugReport",
  "type": "object",
  "required": ["error_type", "message", "file", "line", "function",
               "root_cause", "suggested_fix", "tests_passed"],
  "properties": {
    "error_type":    { "type": "string",  "description": "Python exception class, e.g. KeyError" },
    "message":       { "type": "string",  "description": "Exception message string" },
    "file":          { "type": "string",  "description": "Source file where the error occurred" },
    "line":          { "type": "integer", "description": "Line number of the error" },
    "function":      { "type": "string",  "description": "Function name where the error occurred" },
    "root_cause":    { "type": "string",  "description": "Claude's explanation of the root cause" },
    "suggested_fix": { "type": "string",  "description": "Claude's corrected code or unified diff" },
    "tests_passed":  { "type": "boolean", "description": "True if pytest passes after the fix is applied" },
    "test_output":   { "type": "string",  "description": "Raw pytest stdout/stderr output" }
  }
}
