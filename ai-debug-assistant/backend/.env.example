OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
JWT_SECRET=replace-with-a-long-random-secret
MONGO_URI=mongodb://localhost:27017/
# OAuth 2.0 Web client ID from Google Cloud Console. Keep this equal to the
# NEXT_PUBLIC_GOOGLE_CLIENT_ID configured in frontend/.env.local.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Comma-separated list of browser origins allowed to call the API (CORS).
# Defaults to the local development origins when unset.
CORS_ALLOWED_ORIGINS=
# Directory where browser-uploaded projects are stored before scanning.
UPLOAD_DIR=backend/uploaded_projects
