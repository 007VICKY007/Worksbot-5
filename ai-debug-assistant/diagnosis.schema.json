{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-debug-assistant/schemas/diagnosis.schema.json",
  "title": "Diagnosis",
  "description": "The Diagnosis Engine's root-cause hypothesis for a given failure.",
  "type": "object",
  "required": ["diagnosis_id", "stack_trace_id", "root_cause_summary", "confidence", "evidence"],
  "properties": {
    "diagnosis_id": {
      "type": "string",
      "description": "Unique identifier for this diagnosis (UUID)."
    },
    "stack_trace_id": {
      "type": "string",
      "description": "ID of the StackTrace this diagnosis explains."
    },
    "root_cause_summary": {
      "type": "string",
      "description": "One to three sentence plain-language explanation of the root cause."
    },
    "root_cause_category": {
      "type": "string",
      "enum": [
        "null_or_undefined_reference",
        "type_mismatch",
        "off_by_one_or_index_error",
        "race_condition",
        "resource_exhaustion",
        "misconfiguration",
        "dependency_version_conflict",
        "logic_error",
        "unhandled_edge_case",
        "network_or_timeout",
        "permission_or_auth",
        "other"
      ],
      "description": "Coarse category of the root cause, used for analytics/reporting."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Model's confidence in this diagnosis."
    },
    "evidence": {
      "type": "array",
      "description": "Specific references backing the diagnosis. Every file/line cited here must exist in the retrieved CodeContext — no fabricated references.",
      "items": {
        "type": "object",
        "required": ["chunk_id", "file_path", "explanation"],
        "properties": {
          "chunk_id": {
            "type": "string",
            "description": "ID of the CodeContext chunk this evidence references."
          },
          "file_path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "explanation": {
            "type": "string",
            "description": "Why this location supports the root cause hypothesis."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "alternative_hypotheses": {
      "type": "array",
      "description": "Other plausible root causes, included when confidence is below a threshold (e.g., < 0.6).",
      "items": {
        "type": "object",
        "required": ["summary", "confidence"],
        "properties": {
          "summary": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
